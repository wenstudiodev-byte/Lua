# Salin file ini jadi .env.local lalu isi dengan nilai dari project Supabase kamu.
# Ambil di: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJ... (anon public key)

# (Opsional) CAPTCHA Cloudflare Turnstile untuk login/daftar.
# Isi site key-nya untuk MENGAKTIFKAN CAPTCHA. Kosongkan untuk mematikan.
# Aktifkan juga di Supabase: Authentication -> Settings -> Bot protection (Turnstile) + secret.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# (Opsional) Obfuscate server-side (anti-bypass). Set "1" untuk MENGAKTIFKAN.
# Butuh deploy Netlify Functions (lihat SETUP-SUPABASE.md). Default: client-side.
# VITE_SERVER_OBFUSCATE=1
